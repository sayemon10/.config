{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/fedora.txt",
    "color": {
      "1": "white",
      "2": "bright_white"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "white",
      "title": "bright_white",
      "output": "white"
    },
    "percent": {
      "type": 9,
      "colorGreen": "green",
      "colorYellow": "yellow",
      "colorRed": "red"
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "█",
        "total": "░"
      }
    }
  },

  "modules": [
    "title",
    "separator",

    // ── Hardware ──
    {
      "type": "custom",
      "format": "┌── Hardware ──────────────────────────────"
    },
    { 
      "type": "host",
      "key": "│ 󰍛 Host",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "key": "│ 󰍛 CPU",
      "keyColor": "white",
      "format": "{name} ({cores-logical}C/{cores-physical}T) @ {freq-max}",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 GPU",
      "keyColor": "white",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│ 󰘚 RAM",
      "keyColor": "white"
    },
    {
      "type": "swap",
      "key": "│ 󰓡 Swap",
      "keyColor": "white"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 Disk",
      "keyColor": "white",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────"
    },

    "break",

    // ── Software ──
    {
      "type": "custom",
      "format": "┌── Software ──────────────────────────────"
    },
    {
      "type": "os",
      "key": "│ 󰌢 OS",
      "keyColor": "white"
    },
    {
      "type": "kernel",
      "key": "│ 󰒋 Kernel",
      "keyColor": "white"
    },
    {
      "type": "shell",
      "key": "│ 󰆍 Shell",
      "keyColor": "white"
    },
    {
      "type": "de",
      "key": "│ 󰖲 DE",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": "│ 󰖳 WM",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": "│ 󰆍 Term",
      "keyColor": "white"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Packages",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────"
    },

    "break",

    // ── Network ──
    {
      "type": "custom",
      "format": "┌── Network ───────────────────────────────"
    },
    {
      "type": "localip",
      "key": "│ 󰩟 Local IP",
      "showIpv6": false,
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────"
    },

    "break",

    // ── System ──
    {
      "type": "custom",
      "format": "┌── System ────────────────────────────────"
    },
    {
      "type": "uptime",
      "key": "│ 󰔚 Uptime",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────"
    },

    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
